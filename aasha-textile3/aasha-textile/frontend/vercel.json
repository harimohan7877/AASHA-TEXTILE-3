{
  "crons": [
    {
      "path": "/api/cron/check-new-video",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/cron/(.*)", "destination": "/api/cron/$1" },
    { "source": "/api/(.*)", "destination": "/api/index?path=$1" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/sitemap.xml", "destination": "/api/index?path=sitemap.xml" },
    { "source": "/robots.txt", "destination": "/api/index?path=robots.txt" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
